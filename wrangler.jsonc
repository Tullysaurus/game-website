{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "game-website",
	"compatibility_date": "2026-10-26",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "game-website"
		}
	],
	"d1_databases": [
		{
		"binding": "DATABASE",
		"database_id": "c8af40dd-629e-499b-98da-c19162de14a1",
		"migrations_dir": "prisma/migrations",
		"migrations_pattern": "prisma/migrations/*/migration.sql"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
		"binding": "NEXT_INC_CACHE_R2_BUCKET",
		"bucket_name": "game-website-opennext-cache"
		}
	]
}